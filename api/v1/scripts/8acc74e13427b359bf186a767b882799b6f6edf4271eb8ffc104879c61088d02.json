[{"id":"_meta","name":"纺都颂歌","author":"小烯C2H43g","logo":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/_meta.png","almanac":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/almanac.html"},{"id":"7_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/7_silksong.png","name":"《武德》","team":"fabled","ability":"决斗获胜的玩家不能在下个白天发起决斗，多名玩家同时发起决斗时顺序由说书人决定。"},{"id":"_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/_silksong.png","name":"决斗！","team":"fabled","ability":"如果存活玩家大于三名，提名环节改为“决斗环节”：每个白天每名玩家限一次，你可以公开选择一名玩家并进行一个全体玩家闭眼的猜拳，输的玩家会立刻被处决。第四个白天结束时，邪恶阵营获胜。"},{"id":"1_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/1_silksong.png","otherNightReminder":"得知","reminders":["对手"],"name":"大黄蜂","team":"townsfolk","ability":"每局游戏限一次，在夜晚时*，你可以查看上一个与你决斗的玩家的角色。","otherNight":5},{"id":"2_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/2_silksong.png","otherNightReminder":"发动能力","reminders":["已决斗"],"name":"地图师","team":"townsfolk","ability":"每个夜晚，你会得知与你决斗过的玩家中没有哪个角色类型。","otherNight":6},{"id":"3_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/3_silksong.png","otherNightReminder":"刀人","reminders":["死亡"],"name":"老骑士","team":"townsfolk","ability":"如果你因为决斗被处决，当晚你可以选择一名玩家，如果他不是镇民，他死亡。","otherNight":4},{"id":"4_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/4_silksong.png","otherNightReminder":"转变阵营","reminders":["失去能力","善良"],"name":"跳蚤首领","team":"townsfolk","ability":"首个与你决斗的非镇民玩家会失去能力。如果他是外来者，他转变为善良阵营。","otherNight":2},{"id":"5_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/5_silksong.png","reminders":["不被处决"],"name":"朝圣者","team":"townsfolk","ability":"如果你没有和邪恶玩家决斗过，你在决斗失败时不会被处决。"},{"id":"6_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/6_silksong.png","reminders":["失去能力"],"name":"针姬","team":"townsfolk","ability":"每局游戏限一次，你可以在参与决斗时秘密地改为猜测对方的角色类型，如果你猜对，对方醉酒并被处决，反之你被处决。"},{"id":"8_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/8_silksong.png","firstNightReminder":"选择","reminders":["寄生"],"name":"寄生者","team":"outsider","ability":"在你的首个夜晚，你选择一名其他玩家，如果游戏结束时你与他均存活，你独自获胜。","firstNight":11},{"id":"9_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/9_silksong.png","reminders":["善良","邪恶"],"name":"盗贼","team":"outsider","ability":"你加入上一个决斗获胜的玩家的阵营，但你不会得知阵营变化。"},{"id":"10_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/10_silksong.png","reminders":["失去能力"],"name":"白骑士","team":"minion","ability":"你可以在没有你参与的决斗中秘密的睁眼，每局游戏限一次，你可以在睁眼时秘密向说书人示意修改决斗结果。"},{"id":"11_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/11_silksong.png","otherNightReminder":"毒","reminders":["中毒"],"name":"幽影","team":"minion","ability":"每个白天，首个与你决斗的善良角色会中毒直到下个黄昏。即使你已死亡。","otherNight":3},{"id":"12_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/12_silksong.png","reminders":["继承能力"],"name":"苍白之母","team":"demon","ability":"你拥有一个不在场爪牙角色的能力。死亡的爪牙的能力会被你继承。"},{"id":"13_silksong","image":"https://www.bloodstar.xyz/p/C2H43g/SilkSong/13_silksong.png","remindersGlobal":["附身"],"name":"虚空之神","team":"demon","ability":"游戏开始时，一名镇民被虚空之神附身，被虚空之神附身的玩家“是邪恶的恶魔”。如果你在决斗中失败，则将结果反转为胜利。［-1恶魔，+1镇民］"}]
